DEBUG=1
SECRET_KEY=dev-inseguro-cambia-esto
ALLOWED_HOSTS=*
DATABASE_URL=postgres://retiros:retiros@db:5432/retiros

# Opcional: conexión del dueño de las tablas, para migraciones y políticas RLS.
# Sin ella se usa DATABASE_URL (en local basta). Ver README, "Railway".
# DATABASE_URL_ADMIN=postgres://...

# Superusuario creado en el primer arranque, para entrar a /admin:
DJANGO_CREATE_SUPERUSER=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin1234
# Orígenes desde los que se aceptan formularios (el frontend de Vite).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Zona horaria y formato regional de montos y fechas.
TIME_ZONE=America/Caracas
REGION=es-VE
# Moneda base (VES, USD o EUR): en ella van las cuotas y los totales. Los pagos
# y gastos en otra moneda se registran con su tasa de cambio.
MONEDA=USD

# En producción: DEBUG=0, un SECRET_KEY propio, ALLOWED_HOSTS con tu dominio
# y HTTPS=1 para que las cookies solo viajen cifradas.
# HTTPS=1
# Detrás de un proxy (nginx…) que pone la IP real en X-Forwarded-For:
# PROXY_CONFIABLE=1

# Seguridad del inicio de sesión (valores por defecto):
# 5 intentos fallidos por usuario o 20 por IP en 15 minutos bloquean 15 minutos.
# LIMITE_INTENTOS_USUARIO=5
# LIMITE_INTENTOS_IP=20
# VENTANA_INTENTOS_MINUTOS=15
# BLOQUEO_MINUTOS=15
# La sesión se cierra tras estos minutos sin actividad (la app pregunta antes si
# seguir conectado), al cerrar el navegador y como tope a las SESION_HORAS.
# SESION_INACTIVIDAD_MINUTOS=15
# SESION_HORAS=8
